# Public site and Sanity configuration
SITE_URL=https://www.redtailtelematics.com
NEXT_PUBLIC_SANITY_API_VERSION=2026-04-01
NEXT_PUBLIC_SANITY_PROJECT_ID=bulruaoh
NEXT_PUBLIC_SANITY_DATASET=production

# Public Google Tag Manager container ID. The live value belongs in Vercel
# Production only; use a separate GTM environment for non-production traffic.
NEXT_PUBLIC_GTM_ID=

# Required in production. Choose exactly one delivery provider. SendGrid is the
# migration-compatible provider; webhook is the future CRM/automation option.
LEAD_DELIVERY_PROVIDER=sendgrid

# SendGrid mode. Keep the API key server-only. Production preserves the current
# two-recipient routing; Preview must use isolated non-production recipients.
SENDGRID_API_KEY=
LEAD_EMAIL_FROM=no-reply@redtailtelematics.com
LEAD_EMAIL_FROM_NAME=Redtail Telematics Website
LEAD_EMAIL_RECIPIENTS=

# Webhook mode. Use an HTTPS endpoint owned by the approved CRM/automation
# provider. Local HTTP is accepted only while NODE_ENV=development.
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_ALLOWED_HOSTS=
LEAD_WEBHOOK_BEARER_TOKEN=

# Optional delivery timeout in milliseconds (1000-30000; default 8000).
LEAD_DELIVERY_TIMEOUT_MS=8000

# Optional comma-separated browser origins in addition to SITE_URL and the
# active Vercel deployment URL. Leave blank unless another trusted frontend
# must submit leads to this deployment.
LEAD_ALLOWED_ORIGINS=

# Required in production. Use at least 32 random characters. It HMACs
# rate-limit identifiers before they enter the process-local fallback store.
LEAD_RATE_LIMIT_HASH_SECRET=
